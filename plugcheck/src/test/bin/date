#!/usr/bin/env python3
# macOS-style date shim on a fake clock ($FAKE/now, epoch seconds, local tz)
import sys, os, time, datetime as dt
now=int(open(os.environ['FAKE']+'/now').read())
a=sys.argv[1:]; t=dt.datetime.fromtimestamp(now); fmt='%a %b %d %H:%M:%S %Y'
i=0
while i<len(a):
    x=a[i]
    if x=='-r': t=dt.datetime.fromtimestamp(int(a[i+1])); i+=2; continue
    if x=='-j': i+=1; continue
    if x=='-f': t=dt.datetime.strptime(a[i+2],a[i+1]); i+=3; continue
    if x.startswith('-v'):
        v=x[2:]
        if v.endswith('d'): t+=dt.timedelta(days=int(v[:-1]))
        elif v.endswith('H'): t=t.replace(hour=int(v[:-1]))
        elif v.endswith('M'): t=t.replace(minute=int(v[:-1]))
        elif v.endswith('S'): t=t.replace(second=int(v[:-1]))
        i+=1; continue
    if x.startswith('+'): fmt=x[1:]
    i+=1
if fmt=='%s': print(int(t.timestamp()))
else: print(t.strftime(fmt))
